{
  "manifestVersion": 1,
  "id": "devops-timesheet-extension",
  "version": "1.0.12",
  "name": "Time Sheet for Azure DevOps",
  "description": "Track time spent on work items with comprehensive reporting and export capabilities. Log hours, generate timesheet reports, and export data to CSV/Excel.",
  "publisher": "DMSSWE",
  "categories": ["Azure Boards"],
  "tags": [
    "time tracking",
    "timesheet",
    "work items",
    "reporting",
    "time management",
    "productivity",
    "hours logging"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "images/logo.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE.txt"
    }
  },
  "links": {
    "getstarted": {
      "uri": "https://github.com/your-username/devops-time-sheet#getting-started"
    },
    "support": {
      "uri": "https://github.com/your-username/devops-time-sheet/issues"
    },
    "repository": {
      "uri": "https://github.com/your-username/devops-time-sheet"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/your-username/devops-time-sheet"
  },
  "contributions": [
    {
      "id": "timesheet-tab",
      "type": "ms.vss-work-web.work-item-form-page",
      "description": "Log and view time entries for work items",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "Time Sheet",
        "uri": "dist/timesheet-tab.html",
        "height": 600,
        "supportsMobile": false
      }
    }
  ],
  "scopes": ["vso.work_write"],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    }
  ]
}
