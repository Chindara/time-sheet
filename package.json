{
  "name": "devops-time-sheet",
  "version": "1.2.3",
  "description": "Azure DevOps extension for tracking time on work items",
  "main": "dist/timesheet-tab.js",
  "scripts": {
    "build": "npx webpack-cli --mode production",
    "dev": "npx webpack-cli --mode development --watch",
    "package": "npm run build && npx tfx extension create --manifest-globs vss-extension.json",
    "package:dev": "npx tfx extension create --manifest-globs vss-extension.json --overrides-file vss-extension.dev.json",
    "serve:dev": "npx webpack serve --config webpack.serve.config.js",
    "preview": "npx webpack serve --config webpack.preview.config.js",
    "preview:build": "npx webpack-cli --config webpack.preview.config.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "azure-devops",
    "timesheet",
    "time-tracking",
    "work-items"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "azure-devops-extension-api": "^4.266.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.344.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^2.15.3",
    "tailwind-merge": "^2.6.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.24",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.3",
    "html-webpack-plugin": "^5.6.6",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tfx-cli": "^0.23.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
